@model FriendsInACountryViewModel
@{
    ViewData["Title"] = "All Friends In A Country";
}

<div>
    <h2>All Friends In Sweden</h2>

    @foreach (var friend in Model.Friends)
    {
        <div class="border-bottom pb-3 mb-3">
            <p class="mt-2">@friend.FirstName @friend.LastName</p>
            <div class="col-md-2 themed-grid-col">
            <a asp-controller="Friend" asp-action="ModelView" asp-route-id="@friend.FriendId" class="btn btn-success btn-sm" type="button">View</a>
            </div>
        </div>
    }
</div>
