@model CountryOverviewModel

<!-- Page web-api-info -->
<div class="container px-4 py-4" id="webapi-info">
    <h2 class="pb-2 border-bottom">Country Overview</h2>
    <p>Below you see an overview of friends by country.</p>

    @foreach (var item in Model.CountryInfo ?? [])
    {
        <div class="row mb-2 text-center">
            <div class="col-md-10 themed-grid-col">
                <strong>@item.Country</strong>
                <div class="text-muted small">Friends: @item.NrFriends</div>
            </div>
            <div class="col-md-2 themed-grid-col">
                <a asp-controller="Address" asp-action="FriendsInACountry" asp-route-filter="@item.Country" class="btn btn-success btn-sm" type="button">View</a>
            </div>
        </div>
    }
</div>
