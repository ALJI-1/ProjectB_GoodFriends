@model EditAddressViewModel
@{
    ViewData["Title"] = "Edit Address";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@attribute [IgnoreAntiforgeryToken]

<!-- Page view-quote -->
<div class="container px-4 py-4" id="view-group">
    <form class="needs-validation" method="post" asp-controller="Address" asp-action="Save" novalidate>
        <!-- Hidden fields used to bind input model -->
        <input asp-for="FriendId" value="@Model.FriendId" type="hidden" />
        <input asp-for="AddressIM.AddressId" value="@Model.AddressIM.AddressId" type="hidden" />
        <input asp-for="AddressIM.StatusIM" value="@Model.AddressIM.StatusIM" type="hidden" />
 
        <h2 class="pb-2 border-bottom">
            @Model.PageHeader
            <button class="btn btn-primary-outline" type="submit">
                <svg class="bi text-body-secondary flex-shrink-0 me-3" width="1.75em" height="1.75em"><use xlink:href="#save" /></svg>
            </button>
            @if (Model.AddressIM.StatusIM != Models.Common.StatusIM.Inserted)
            {
                <button class="btn btn-primary-outline" type="submit" asp-action="Undo">
                    <svg class="bi text-body-secondary flex-shrink-0 me-3" width="1.75em" height="1.75em"><use xlink:href="#undo" /></svg>
                </button>
            }
        </h2>

        @if (Model.ErrorMessage != null)
        {
            <div class="row mb-1 text-center">
                <span class="alert alert-danger" role="alert">
                    @Model.ErrorMessage
                </span>
            </div>
        }
        else
        {
            <!-- Server side validation errors, rough but just in case client side validation is not working or tampered with -->
            @if (Model.HasValidationErrors)
            {
                <div class="row g-3">
                    @foreach (var item in Model.ValidationErrorMsgs)
                    {
                        <span class="alert alert-danger" role="alert">
                            @item
                        </span>
                    }
                </div>
            }
            <div class="row row-cols-1 row-cols-lg-4 align-items-stretch g-4 py-5">
                <div class="col-md-7 col-lg-10">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label for="StreetAddress" class="form-label">Street Address</label>
                            <input type="text" class="form-control" asp-for="AddressIM.StreetAddress" id="StreetAddress">
                        <span asp-validation-for="AddressIM.StreetAddress" class="invalid-feedback"></span>
                        </div>
                        <div class="col-sm-6">
                        </div>
                        <div class="col-sm-12">
                            <label for="ZipCode" class="form-label">Zip Code</label>
                            <input type="text" class="form-control" asp-for="AddressIM.ZipCode" id="ZipCode">
                        <span asp-validation-for="AddressIM.ZipCode" class="invalid-feedback"></span>
                        </div>
                        <div class="col-sm-12">
                            <label for="City" class="form-label">City</label>
                            <input type="text" class="form-control" asp-for="AddressIM.City" id="City">
                        <span asp-validation-for="AddressIM.City" class="invalid-feedback"></span>
                        </div>
                        <div class="col-sm-12">
                            <label for="Country" class="form-label">Country</label>
                            <input type="text" class="form-control" asp-for="AddressIM.Country" id="Country">
                        <span asp-validation-for="AddressIM.Country" class="invalid-feedback"></span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </form>

    <!-- inital template that can be easily hidden -->
    <div class="d-none">
        <form class="needs-validation" method="post" novalidate>
            <h2 class="pb-2 border-bottom">
                TEMPLATE
                <button class="btn btn-primary-outline" type="submit">
                    <svg class="bi text-body-secondary flex-shrink-0 me-3" width="1.75em" height="1.75em"><use xlink:href="#save" /></svg>
                </button>
                <button class="btn btn-primary-outline" type="submit">
                    <svg class="bi text-body-secondary flex-shrink-0 me-3" width="1.75em" height="1.75em"><use xlink:href="#undo" /></svg>
                </button>
            </h2>

            <div class="row row-cols-1 row-cols-lg-4 align-items-stretch g-4 py-5">
                <div class="col-md-7 col-lg-10">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label for="author" class="form-label">Author</label>
                            <input type="text" class="form-control" id="author" value="Sir Connan Doyle" readonly>
                        </div>
                        <div class="col-sm-6">
                        </div>
                        <div class="col-sm-12">
                            <label for="quote" class="form-label">Quote</label>
                            <input type="text" class="form-control" id="quote" value="Sherlock is best" readonly>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
