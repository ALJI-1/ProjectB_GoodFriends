@model EditFriendViewModel
@{
    ViewData["Title"] = "Edit Friend";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@attribute [IgnoreAntiforgeryToken]


<div class="container px-4 py-4" id="view-group">
    <form class="needs-validation" method="post" asp-controller="Friend" asp-action="Save" novalidate>

        <input asp-for="FriendIM.FriendId" value="@Model!.FriendIM!.FriendId" type="hidden" />
        <input asp-for="FriendIM.StatusIM" value="@Model.FriendIM!.StatusIM" type="hidden" />
 
        <h2 class="pb-2 border-bottom">
            @Model.PageHeader
            <button class="btn btn-primary-outline" type="submit">
                <svg class="bi text-body-secondary flex-shrink-0 me-3" width="1.75em" height="1.75em"><use xlink:href="#save" /></svg>
            </button>
            @if (Model.FriendIM.StatusIM != Models.Common.StatusIM.Inserted)
            {
                <button class="btn btn-primary-outline" type="submit" asp-action="Undo">
                    <svg class="bi text-body-secondary flex-shrink-0 me-3" width="1.75em" height="1.75em"><use xlink:href="#undo" /></svg>
                </button>
            }
        </h2>

        @if (Model.ErrorMessage != null)
        {
            <div class="row mb-1 text-center">
                <span class="alert alert-danger" role="alert">
                    @Model.ErrorMessage
                </span>
            </div>
        }
        else
        {
            @if (Model.HasValidationErrors)
            {
                <div class="row g-3">
                    @foreach (var item in Model.ValidationErrorMsgs)
                    {
                        <span class="alert alert-danger" role="alert">
                            @item
                        </span>
                    }
                </div>
            }
            <div class="row row-cols-1 row-cols-lg-4 align-items-stretch g-4 py-5">
                <div class="col-md-7 col-lg-10">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label for="firstName" class="form-label">First name</label>
                            <input type="text" class="form-control" asp-for="FriendIM.FirstName" id="firstName">
                            <span asp-validation-for="FriendIM.FirstName" class="invalid-feedback"></span>
                        </div>
                        <div class="col-sm-6">
                        </div>
                        <div class="col-sm-12">
                            <label for="lastName" class="form-label">Last name</label>
                            <input type="text" class="form-control" asp-for="FriendIM.LastName" id="lastName">                           
                            <span asp-validation-for="FriendIM.LastName" class="invalid-feedback"></span>
                        </div>
                        <div class="col-sm-12">
                            <label for="email" class="form-label">Email</label>
                            <input type="text" class="form-control" asp-for="FriendIM.Email" id="email">
                            <span asp-validation-for="FriendIM.Email" class="invalid-feedback"></span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
