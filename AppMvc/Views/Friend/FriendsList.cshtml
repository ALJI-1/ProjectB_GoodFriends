@model FriendsListViewModel
@{
    ViewData["Title"] = "Friends List";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@attribute [IgnoreAntiforgeryToken]
<div id="list-of-friends">
    <h2 class="pb-2 border-bottom">List of friends</h2>

    <p>Below are some friends with their details. Select one that you want to view.</p>
    @foreach (var item in Model.Friends)
    {
        <div class="row mb-2 text-center">
            <div class="col-md-10 themed-grid-col">
                <strong>@item.FirstName @item.LastName</strong>
                <div class="text-end fst-italic">@item.Email</div>
                <div class="text-muted small">@item.FriendId</div>
            </div>
            <div class="col-md-2 themed-grid-col">
                <a asp-controller="Friend" asp-action="ModelView" asp-route-id="@item.FriendId" class="btn btn-success btn-sm" type="button">View</a>
                <a asp-controller="Friend" asp-action="EditFriend" asp-route-id="@item.FriendId" class="btn btn-success btn-sm" type="button">Edit</a>
            </div>
        </div>
    }
    <nav aria-label="Standard pagination example" class="mt-4 mb-5">
        <ul class="pagination">
            <li class="page-item">
                <a class="page-link" asp-controller="Friend" asp-action="FriendsList" asp-route-pagenr="@Model.PrevPageNr" aria-label="Previous">
                    <span aria-hidden="true">&laquo;</span>
                </a>
            </li>
            @{
                int startPage = Math.Max(0, Model.ThisPageNr - 1);
                int endPage = Math.Min(Model.PresentPages - 1, Model.ThisPageNr + 1);
            }
            @for (int i = startPage; i <= endPage; i++)
            {
                <li class="page-item @(i == Model.ThisPageNr ? "active" : "")">
                    <a class="page-link" asp-controller="Friend" asp-action="FriendsList" asp-route-pagenr="@i">@(i+1)</a>
                </li>
            }
            <li class="page-item">
                <a class="page-link" asp-controller="Friend" asp-action="FriendsList" asp-route-pagenr="@Model.NextPageNr" aria-label="Next">
                    <span aria-hidden="true">&raquo;</span>
                </a>
            </li>
        </ul>
    </nav>
</div>
