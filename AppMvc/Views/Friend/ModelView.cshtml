@model ModelViewModel
@{
    ViewData["Title"] = "Friend Details";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@attribute [IgnoreAntiforgeryToken]

<div class="container px-4 py-4" id="view-group">
    <form class="needs-validation" novalidate>
        <div class="d-flex align-items-center pb-2 border-bottom mb-3">
            <a asp-controller="Friend" asp-action="EditFriend" asp-route-id="@Model.Friend?.FriendId" class="btn btn-outline-primary me-3">
                <svg class="bi" width="1.5em" height="1.5em"><use xlink:href="#edit" /></svg>
            </a>
            <h2 class="mb-0">View details of a Friend</h2>
        </div>

        @if (Model.ErrorMessage != null)
        {
            <div class="row mb-1 text-center">
                <span class="alert alert-danger" role="alert">
                    @Model.ErrorMessage
                </span>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-lg-4 align-items-stretch g-4 py-5">
                <div class="col-md-7 col-lg-10">
 
                    <div class="row g-3">
                        
                        <div class="col-sm-6">
                            <label for="friendId" class="form-label">FriendId</label>
                            <input type="text" class="form-control" id="friendId" value="@Model.Friend?.FriendId" readonly>
                        </div>
                        <div class="col-sm-12">
                            <label for="friendName" class="form-label">Friend Name</label>
                            <input type="text" class="form-control" id="friendName" value="@Model.Friend?.FirstName @Model.Friend?.LastName" readonly>
                        </div>

                        <div class="col-sm-12">
                            <label for="friendPets" class="form-label">Friends Pets</label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="friendPets" value="@(Model.Friend?.Pets?.Count ?? 0)" readonly>
                                @if ((Model.Friend?.Pets?.Count ?? 0) > 0)
                                {
                                    <a asp-controller="Friend" asp-action="FriendsDetails" asp-route-id="@Model.Friend?.FriendId" asp-route-view="pets" class="btn btn-success btn-sm" type="button">View</a>
                                }
                                else
                                {
                                    <button class="btn btn-secondary btn-sm" type="button" disabled>View</button>
                                }
                            </div>  
                        </div>

                        <div class="col-sm-12">
                            <label for="friendQuotes" class="form-label">Friends Quotes</label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="friendQuotes" value="@(Model.Friend?.Quotes?.Count ?? 0)" readonly>
                                @if ((Model.Friend?.Quotes?.Count ?? 0) > 0)
                                {
                                    <a asp-controller="Friend" asp-action="FriendsDetails" asp-route-id="@Model.Friend?.FriendId" asp-route-view="quotes" class="btn btn-success btn-sm" type="button">View</a>
                                }
                                else
                                {
                                    <button class="btn btn-secondary btn-sm" type="button" disabled>View</button>
                                }
                            </div>                            
                        </div>

                        <div class="col-sm-12">
                            <div class="d-flex align-items-center mb-2">
                                <a asp-controller="Address" asp-action="EditAddress" asp-route-id="@Model.Friend?.FriendId" class="btn btn-outline-primary me-3">
                                    <svg class="bi" width="1.5em" height="1.5em"><use xlink:href="#edit" /></svg>
                                </a>
                                <label class="form-label mb-0">Address</label>
                            </div>
                            <input type="text" class="form-control mb-2" id="friendStreet" placeholder="Street Address" value="@(Model.Friend?.Address?.StreetAddress ?? "")" readonly>                           
                            <div class="row g-2">
                                <div class="col-sm-6">
                                    <input type="text" class="form-control" id="friendZip" placeholder="Zip Code" value="@(Model.Friend?.Address?.ZipCode ?? null)" readonly>
                                </div>
                                <div class="col-sm-6">
                                    <input type="text" class="form-control" id="friendCity" placeholder="City" value="@(Model.Friend?.Address?.City ?? "")" readonly>
                                </div>
                            </div>
                            <input type="text" class="form-control mt-2" id="friendCountry" placeholder="Country" value="@(Model.Friend?.Address?.Country ?? "")" readonly>
                        </div>
                    </div>

                </div>
            </div>
        }
    </form>
</div>
