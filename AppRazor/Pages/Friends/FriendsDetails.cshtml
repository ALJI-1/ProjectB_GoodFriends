@page
@model AppRazor.Pages.Friends.FriendsDetailsModel
@{
    ViewData["Title"] = Model.ViewType == "pets" ? "Friend's Pets" : "Friend's Quotes";
}

<div class="container px-4 py-4">
    @if (Model.ErrorMessage != null)
    {
        <div class="alert alert-danger" role="alert">
            @Model.ErrorMessage
        </div>
    }
    else if (Model.Friend != null)
    {
        <h2 class="pb-2 border-bottom">@Model.Friend.FirstName @Model.Friend.LastName - @(Model.ViewType == "pets" ? "Pets" : "Quotes")</h2>

        @if (Model.ViewType == "pets")
        {
            @if (Model.PetsIM.Any())
            {
                <form method="post">
                    
                <input type="hidden" name="id" data-seido-selected-item-id-target />
                <input type="hidden" name="viewType" value="@Model.ViewType" />
                <input type="hidden" name="friendId" value="@Model.Friend.FriendId" />

                @foreach (var pet in Model.PetsIM)
                {
                    <div class="row mb-2 text-center">
                        <div class="col-md-10 themed-grid-col">
                            <strong>@pet.Name</strong>
                            <div class="text-muted small">Mood: @pet.Mood</div>
                        </div>
                        <div class="col-md-2 themed-grid-col">
                            <button type="button" class="w-100 btn btn-danger my-1" 
                                data-bs-toggle="modal" data-bs-target="#deleteModal"
                                data-seido-selected-item-id="@pet.PetId"
                                data-seido-modal-title="@pet.PetId" 
                                data-seido-modal-body="About to delete @pet.PetId" 
                                data-seido-modal-cancel="Close" data-seido-modal-Ok="Delete">
                                Delete
                            </button>
                        </div>
                    </div>
                }
                <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="softModalLabel" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title text-danger" id="softModalLabel">Confirm deletion</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <p>Are you sure you want to delete this pet?</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" asp-page-handler="Delete" class="btn btn-primary btn-danger">Ok</button>
                            </div>
                        </div>
                    </div>
                </div>
                </form>
            }
            else
            {
                <p class="text-muted">This friend has no pets.</p>
            }
        }
        else if (Model.ViewType == "quotes")
        {
            @if (Model.QuotesIM.Any())
            {
                <form method="post">
                    
                <input type="hidden" name="id" data-seido-selected-item-id-target />
                <input type="hidden" name="viewType" value="@Model.ViewType" />
                <input type="hidden" name="friendId" value="@Model.Friend.FriendId" />

                @foreach (var quote in Model.QuotesIM)
                {
                    <div class="row mb-2 text-center">
                        <div class="col-md-10 themed-grid-col">
                            <strong>"@quote.Quote"</strong>
                            <div class="text-muted small">- @quote.Author</div>
                        </div>
                        <div class="col-md-2 themed-grid-col">
                            <button type="button" class="w-100 btn btn-danger my-1" 
                                data-bs-toggle="modal" data-bs-target="#deleteModal"
                                data-seido-selected-item-id="@quote.QuoteId"
                                data-seido-modal-title="@quote.QuoteId" 
                                data-seido-modal-body="About to delete @quote.QuoteId" 
                                data-seido-modal-cancel="Close" data-seido-modal-Ok="Delete">
                                Delete
                            </button>
                        </div>
                    </div>
                }
                <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="softModalLabel" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title text-danger" id="softModalLabel">Confirm deletion</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <p>Are you sure you want to delete this quote?</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" asp-page-handler="Delete" class="btn btn-primary btn-danger">Ok</button>
                            </div>
                        </div>
                    </div>
                </div>
                </form>
            }
            else
            {
                <p class="text-muted">This friend has no quotes.</p>
            }
        }
    }
</div>
@section Scripts {
    <script src="~/script/seido/select-list-items.js"></script>
}