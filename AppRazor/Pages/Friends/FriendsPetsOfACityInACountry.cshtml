@page
@model AppRazor.Pages.Friends.FriendsPetsOfACityInACountryModel
@{
}

<!-- Page web-api-info -->
<div class="container px-4 py-4" id="webapi-info">
    <h2 class="pb-2 border-bottom">WebApi info</h2>
    <p>Below you see an overview of the content presented by the WebApi. Click on the link to see details. </p>

@foreach (var item in Model.CityInfoList)
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 g-4 py-5">
            <div class="col d-flex align-items-start">
                <svg class="bi text-body-secondary flex-shrink-0 me-3" width="1.75em" height="1.75em"><use xlink:href="#boombox"/></svg>
                <div>
                    <h3 class="fw-bold mb-0 fs-4 text-body-emphasis">@(item.City != null ? item.City : item.Country)</h3>
                    <p>Friends: @item.NrFriends Pets: @item.NrPets</p>
                </div>
            </div>
        </div>
    }
</div>
