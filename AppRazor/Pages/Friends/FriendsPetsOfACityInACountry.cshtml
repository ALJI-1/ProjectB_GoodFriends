@page
@model AppRazor.Pages.Friends.FriendsPetsOfACityInACountryModel
@{
}

<!-- Page web-api-info -->
<div class="container px-4 py-4" id="webapi-info">
    <h2 class="pb-2 border-bottom">Cities Overview</h2>
    <p>Below you see an overview of friends and pets by city.</p>

    @foreach (var item in Model.CityInfoList)
    {
        <div class="row mb-2 text-center">
            <div class="col-md-10 themed-grid-col">
                <strong>@(item.City ?? item.Country)</strong>
                <div class="text-muted small">Friends: @item.NrFriends - Pets: @item.NrPets</div>
            </div>
            <div class="col-md-2 themed-grid-col">
                <button class="btn btn-success btn-sm" type="button">View</button>
            </div>
        </div>
    }
</div>
