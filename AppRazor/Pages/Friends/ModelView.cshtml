@page
@model AppRazor.Pages.Friends.ModelViewModel
@{
    ViewData["Title"] = "ModelView";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@attribute [IgnoreAntiforgeryToken]

<div class="container px-4 py-4" id="view-group">
    <form class="needs-validation" novalidate>
        <h2 class="pb-2 border-bottom">
            View details of a Friend

            <!-- Without Validation -->
            
                <a asp-page="EditFriend" asp-route-id=@Model.Friend?.FriendId >
                    
                <svg class="bi text-body-secondary flex-shrink-0 me-3" width="1.75em" height="1.75em"><use xlink:href="#edit" /></svg>
                </a>
           

        </h2>

        @if (Model.ErrorMessage != null)
        {
            <div class="row mb-1 text-center">
                <span class="alert alert-danger" role="alert">
                    @Model.ErrorMessage
                </span>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-lg-4 align-items-stretch g-4 py-5">
                <div class="col-md-7 col-lg-10">
 
                    <div class="row g-3">
                        
                        <div class="col-sm-6">
                            <label for="friendId" class="form-label">FriendId</label>
                            <input type="text" class="form-control" id="friendId" value="@Model.Friend?.FriendId" readonly>
                        </div>
                        <div class="col-sm-12">
                            <label for="friendName" class="form-label">Friend Name</label>
                            <input type="text" class="form-control" id="friendName" value="@Model.Friend?.FirstName @Model.Friend?.LastName" readonly>
                        </div>

                        <div class="col-sm-12">
                            <label for="friendPets" class="form-label">Friends Pets</label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="friendPets" value="@(Model.Friend?.Pets?.Count ?? 0)" readonly>
                                <a asp-page="FriendsDetails" asp-route-id="@Model.Friend?.FriendId" asp-route-view="pets" class="btn btn-success btn-sm" type="button">View</a>
                            </div>  
                        </div>

                        <div class="col-sm-12">
                            <label for="friendQuotes" class="form-label">Friends Quotes</label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="friendQuotes" value="@(Model.Friend?.Quotes?.Count ?? 0)" readonly>
                                <a asp-page="FriendsDetails" asp-route-id="@Model.Friend?.FriendId" asp-route-view="quotes" class="btn btn-success btn-sm" type="button">View</a>
                            </div>                            
                        </div>

                        <div class="col-sm-12">
                            <label class="form-label">Address
                                <a asp-page="EditAddress" asp-route-id=@Model.Friend?.FriendId >                   
                                <svg class="bi text-body-secondary flex-shrink-0 me-3" width="1.75em" height="1.75em"><use xlink:href="#edit" /></svg>
                                </a>

                            </label>
                            <input type="text" class="form-control mb-2" id="friendStreet" placeholder="Street Address" value="@(Model.Friend?.Address?.StreetAddress ?? "")" readonly>                           
                            <div class="row g-2">
                                <div class="col-sm-6">
                                    <input type="text" class="form-control" id="friendZip" placeholder="Zip Code" value="@(Model.Friend?.Address?.ZipCode ?? null)" readonly>
                                </div>
                                <div class="col-sm-6">
                                    <input type="text" class="form-control" id="friendCity" placeholder="City" value="@(Model.Friend?.Address?.City ?? "")" readonly>
                                </div>
                            </div>
                            <input type="text" class="form-control mt-2" id="friendCountry" placeholder="Country" value="@(Model.Friend?.Address?.Country ?? "")" readonly>
                        </div>
                    </div>

                </div>
            </div>
        }
    </form>

    <!-- inital template that can be easily hidden -->
    <div class="d-none">
        <form class="needs-validation" method="post" novalidate>
            <h2 class="pb-2 border-bottom">
                TEMPLATE
                <a href="#">
                    <svg class="bi text-body-secondary flex-shrink-0 me-3" width="1.75em" height="1.75em"><use xlink:href="#edit" /></svg>
                </a>
            </h2>

            <div class="row row-cols-1 row-cols-lg-4 align-items-stretch g-4 py-5">
                <div class="col-md-7 col-lg-10">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label for="author" class="form-label">Author</label>
                            <input type="text" class="form-control" id="author" value="Sir Connan Doyle" readonly>
                        </div>
                        <div class="col-sm-6">
                            <label for="quoteId" class="form-label">QuoteId</label>
                            <input type="text" class="form-control" id="quoteId" value="123-123" readonly>
                        </div>
                        <div class="col-sm-12">
                            <label for="quote" class="form-label">Quote</label>
                            <input type="text" class="form-control" id="quote" value="Sherlock is best" readonly>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>



